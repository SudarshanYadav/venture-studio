# Copy to .env (git-ignored) or set in the host's environment settings. Never commit real values.
# Razorpay TEST keys only until the founder approves going live.
RAZORPAY_KEY_ID=[RAZORPAY_TEST_KEY_ID]
RAZORPAY_KEY_SECRET=[RAZORPAY_TEST_KEY_SECRET]
# Live keys (rzp_live_...) are refused unless this is true. Set only with founder OK.
ALLOW_LIVE_PAYMENTS=false

# Meta Pixel / dataset ID (also set CONFIG.pixelId in index.html) and Conversions API token
META_PIXEL_ID=[META_PIXEL_ID]
META_CAPI_TOKEN=[META_CAPI_ACCESS_TOKEN]
# From Events Manager > Test Events while testing; remove before launch
META_TEST_EVENT_CODE=[META_TEST_EVENT_CODE]
META_GRAPH_VERSION=v23.0
